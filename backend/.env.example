# ---------------------------------------------------------------------------
# Example environment configuration.
# Copy to `.env` and adjust. Every value here is optional; defaults are in
# `app/core/config.py`. Training hyperparameters live in `configs/*.yaml`.
# ---------------------------------------------------------------------------

# --- Model / encoder -------------------------------------------------------
MODEL_NAME=bert-base-uncased
# Optional path to a trained checkpoint (saved by the training pipeline).
# When empty, the server auto-loads a previously trained checkpoint if one is
# available (checkpoints/default.json pointer or conventional paths).
MODEL_CHECKPOINT=
# Set to false to disable checkpoint auto-loading (always serve untrained).
AUTO_LOAD_CHECKPOINT=true
# auto | cuda | cpu  (auto picks CUDA when available, else CPU)
DEVICE=auto
# pretrained | random  (random is for tests/dev without downloading weights)
INIT_BACKBONE=pretrained
MAX_SEQ_LENGTH=128
# full | frozen | partial
ENCODER_FREEZE_MODE=full
# Number of bottom layers frozen in "partial" mode (embeddings always frozen)
ENCODER_FROZEN_LAYERS=4
INTERACTION_HIDDEN_DIM=1024
INTERACTION_DROPOUT=0.2

# --- Label sets (comma separated; must match the dataset annotations) ------
HATE_LABELS=hate,offensive,normal
TARGET_LABELS=race,ethnicity,nationality,religion,gender,sexual_orientation,political_group,other,none
REASON_LABELS=insult,dehumanization,negative_stereotyping,threat,exclusion,discrimination,incitement_to_violence,other
# Threshold used only when the hate head is explicitly configured in binary mode.
HATE_THRESHOLD=0.5

# --- Multi-task loss weights -----------------------------------------------
LAMBDA_HATE=1.0
LAMBDA_TARGET=1.0
LAMBDA_REASON=1.0
LAMBDA_CONTRASTIVE=0.5
LAMBDA_EVIDENCE=1.0

# --- Contrastive learning ---------------------------------------------------
CONTRASTIVE_TEMPERATURE=0.07
CONTRASTIVE_PROJECTION_DIM=256

# --- Evidence extraction (attribution) --------------------------------------
# integrated_gradients | gradient_x_input
EVIDENCE_METHOD=integrated_gradients
EVIDENCE_TOP_K=5
# Relative score threshold: keep tokens with score >= EVIDENCE_MIN_SCORE * max_score
EVIDENCE_MIN_SCORE=0.15
EVIDENCE_IG_STEPS=32

# --- Misc -------------------------------------------------------------------
SEED=42
LOG_LEVEL=INFO
# Comma separated origins for CORS, or * for all (local research prototype).
CORS_ORIGINS=*
